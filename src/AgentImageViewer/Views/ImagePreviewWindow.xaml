<Window
    x:Class="AgentImageViewer.Views.ImagePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Image Preview"
    AllowsTransparency="True"
    Background="#B0000000"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    UseLayoutRounding="True"
    MouseLeftButtonDown="OnMouseLeftButtonDown"
    MouseMove="OnMouseMove"
    MouseLeftButtonUp="OnMouseLeftButtonUp"
    MouseWheel="OnMouseWheel"
    KeyDown="OnKeyDown">
    <Grid x:Name="Stage" Margin="48">
        <Image
            x:Name="PreviewImage"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Cursor="Hand"
            RenderOptions.BitmapScalingMode="HighQuality"
            Stretch="Fill">
            <!-- Wheel zoom and drag pan; the layout size stays the fitted size. -->
            <Image.RenderTransform>
                <MatrixTransform x:Name="ZoomTransform" />
            </Image.RenderTransform>
        </Image>

        <!-- Placed just above the image (positioned in code) and grows upward with more lines. -->
        <Border
            x:Name="MessagePanel"
            MaxWidth="1100"
            Padding="18,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#E6202020"
            CornerRadius="8">
            <TextBlock
                x:Name="MessageText"
                FontSize="15"
                Foreground="#F2FFFFFF"
                LineHeight="22"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
