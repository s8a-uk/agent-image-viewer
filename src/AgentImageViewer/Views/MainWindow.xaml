<ui:FluentWindow
    x:Class="AgentImageViewer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:cards="clr-namespace:AgentImageViewer.Core.Cards;assembly=AgentImageViewer.Core"
    xmlns:imaging="clr-namespace:AgentImageViewer.Imaging"
    Title="Agent Image Viewer"
    Width="440"
    MinWidth="300"
    MaxWidth="1600"
    MinHeight="80"
    SizeToContent="Height"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    WindowStartupLocation="Manual"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
    PreviewMouseMove="OnPreviewMouseMove"
    PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    KeyDown="OnKeyDown">

    <ui:FluentWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="非表示" Click="OnHideClick" />
            <MenuItem Header="履歴をクリア" Click="OnClearClick" />
            <Separator />
            <MenuItem Header="設定..." Click="OnSettingsClick" />
            <MenuItem Header="終了" Click="OnExitClick" />
        </ContextMenu>
    </ui:FluentWindow.ContextMenu>

    <Grid Margin="10">
        <ScrollViewer
            x:Name="Scroller"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardList" Margin="0,0,0,-8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type cards:ResponseCard}">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.ContextMenu>
                                <!-- The card's own items, then the window menu, so a right-click anywhere offers both. -->
                                <ContextMenu>
                                    <MenuItem Header="テキストをコピー" Click="OnCopyTextClick" IsEnabled="{Binding HasText}" />
                                    <MenuItem Header="このカードを削除" Click="OnRemoveCardClick" />
                                    <Separator />
                                    <MenuItem Header="非表示" Click="OnHideClick" />
                                    <MenuItem Header="履歴をクリア" Click="OnClearClick" />
                                    <Separator />
                                    <MenuItem Header="設定..." Click="OnSettingsClick" />
                                    <MenuItem Header="終了" Click="OnExitClick" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding TimeLabel}" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <TextBlock
                                    x:Name="BodyText"
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding SingleLineText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTip="{Binding Text}" />

                                <ItemsControl Margin="0,0,-6,-6" ItemsSource="{Binding Images}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type imaging:ThumbnailImage}">
                                            <!--
                                                A button for the keyboard (Tab, then Enter or Space) and screen readers.
                                                Mouse clicks are handled by the window, which also drags.
                                            -->
                                            <Button
                                                Margin="0,0,6,6"
                                                AutomationProperties.Name="{Binding FileName}"
                                                Click="OnThumbnailClick"
                                                Cursor="Hand"
                                                FocusVisualStyle="{x:Null}"
                                                Tag="Thumbnail"
                                                ToolTip="{Binding FileName}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="Frame"
                                                            Padding="2"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="Frame" Property="Padding" Value="1" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <!-- Fills half the card width; very tall images are capped. -->
                                                <Image
                                                    MaxHeight="320"
                                                    Source="{Binding Thumbnail}"
                                                    Stretch="Uniform" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasText}" Value="False">
                                <Setter TargetName="BodyText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
