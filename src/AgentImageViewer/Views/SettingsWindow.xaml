<ui:FluentWindow
    x:Class="AgentImageViewer.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="設定 - Agent Image Viewer"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar Title="設定" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Margin="20,8,20,20">
            <ui:CardControl Margin="0,0,0,8" Header="表示する最大件数">
                <ui:NumberBox
                    x:Name="MaxCardsBox"
                    Width="140"
                    ClearButtonEnabled="False"
                    MaxDecimalPlaces="0"
                    SmallChange="1" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Header="テーマ">
                <!-- Item order matches the AppTheme enum. -->
                <ComboBox x:Name="ThemeBox" Width="180">
                    <ComboBoxItem Content="システムに合わせる" />
                    <ComboBoxItem Content="ライト" />
                    <ComboBoxItem Content="ダーク" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Header="ウィンドウの不透明度">
                <StackPanel Orientation="Horizontal">
                    <Slider
                        x:Name="OpacitySlider"
                        Width="160"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="30"
                        TickFrequency="5" />
                    <TextBlock
                        Width="44"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}"
                        TextAlignment="Right" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Header="受信時に音を鳴らす">
                <ui:ToggleSwitch x:Name="SoundSwitch" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Header="常に最前面に表示">
                <ui:ToggleSwitch x:Name="TopmostSwitch" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,16" Header="Windows の起動時に自動で起動">
                <ui:ToggleSwitch x:Name="StartupSwitch" />
            </ui:CardControl>

            <DockPanel>
                <TextBlock
                    x:Name="VersionText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Click="OnSaveClick"
                        Content="保存"
                        IsDefault="True" />
                    <ui:Button Click="OnCancelClick" Content="キャンセル" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
